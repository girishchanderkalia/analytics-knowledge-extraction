{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge/domain-record.schema.json",
  "title": "Domain Knowledge Record",

  "type": "object",

  "required": [
    "id",
    "platformId",
    "status",
    "sourceRefs",
    "evidenceState",
    "runtimeAuthorized",
    "approvalRef"
  ],

  "properties": {

    "id": {
      "type": "string",
      "minLength": 1
    },

    "platformId": {
      "type": "string",
      "minLength": 1
    },

    "status": {
      "enum": [
        "draft",
        "approved",
        "retired",
        "rejected"
      ]
    },

    "sourceRefs": {
      "type": "array",
      "minItems": 1
    },

    "evidenceState": {
      "type": "string"
    },

    "runtimeAuthorized": {
      "type": "boolean"
    },

    "approvalRef": {
      "type": "object",

      "required": [
        "approvalId",
        "path",
        "sha256"
      ]
    }

  },

  "additionalProperties": true
}