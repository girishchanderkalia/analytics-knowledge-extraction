{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge/semantic-mapping-record.schema.json",
  "title": "Semantic Mapping Knowledge Record",

  "type": "object",

  "required": [
    "id",
    "platformId",
    "status",
    "classification",
    "evidenceState",
    "runtimeEligible",
    "runtimeAuthorized",
    "domainRecordRefs",
    "physicalRecordRefs",
    "sourceRefs"
  ],

  "properties": {

    "id": {
      "type": "string",
      "minLength": 1
    },

    "platformId": {
      "type": "string",
      "minLength": 1
    },

    "status": {
      "enum": [
        "draft",
        "approved",
        "retired",
        "rejected"
      ]
    },

    "classification": {
      "enum": [
        "verified",
        "partially-verified",
        "conflict",
        "inferred",
        "unresolved",
        "deprecated"
      ]
    },

    "evidenceState": {
      "enum": [
        "verified",
        "partially-verified",
        "conflict",
        "inferred",
        "unresolved",
        "deprecated"
      ]
    },

    "runtimeEligible": {
      "type": "boolean"
    },

    "runtimeAuthorized": {
      "type": "boolean"
    },

    "domainRecordRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "physicalRecordRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },

    "approvalRef": {
      "type": "object",
      "properties": {
        "approvalId": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      },
      "required": [
        "approvalId",
        "path",
        "sha256"
      ],
      "additionalProperties": true
    }

  },

  "additionalProperties": true
}